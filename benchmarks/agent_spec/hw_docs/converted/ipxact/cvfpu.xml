      <ipxact:value>fpnew_pkg::fpu_features_t</ipxact:value>
      <ipxact:description>FPU features definition</ipxact:description>
    </ipxact:parameter>
    <ipxact:parameter parameterId="Implementation" type="string" resolve="user">
      <ipxact:name>Implementation</ipxact:name>
      <ipxact:displayName>Implementation</ipxact:displayName>
      <ipxact:value>fpnew_pkg::fpu_implementation_t</ipxact:value>
      <ipxact:description>FPU implementation definition</ipxact:description>
    </ipxact:parameter>
    <ipxact:parameter parameterId="DivSqrtSel" type="string" resolve="user">
      <ipxact:name>DivSqrtSel</ipxact:name>
