        <ipxact:name>result_o</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>out</ipxact:direction>
          <ipxact:vector>
            <ipxact:left>W-1</ipxact:left>
            <ipxact:right>0</ipxact:right>
          </ipxact:vector>
