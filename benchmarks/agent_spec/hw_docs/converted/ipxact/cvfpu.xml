      <ipxact:value>fpnew_pkg::fpu_divsqrt_t</ipxact:value>
      <ipxact:description>Select division/square root unit</ipxact:description>
    </ipxact:parameter>
    <ipxact:parameter parameterId="TagType" type="string" resolve="user">
      <ipxact:name>TagType</ipxact:name>
      <ipxact:displayName>TagType</ipxact:displayName>
      <ipxact:value>logic</ipxact:value>
      <ipxact:description>SV data type of the operation tag</ipxact:description>
    </ipxact:parameter>
    <ipxact:parameter parameterId="TrueSIMDClass" type="bit" resolve="user">
      <ipxact:name>TrueSIMDClass</ipxact:name>
      <ipxact:displayName>TrueSIMDClass</ipxact:displayName>
      <ipxact:value>true</ipxact:value>
      <ipxact:description>Vectorial class RISC-V compliance</ipxact:description>
    </ipxact:parameter>
    <ipxact:parameter parameterId="EnableSIMDMask" type="bit" resolve="user">
      <ipxact:name>EnableSIMDMask</ipxact:name>
      <ipxact:displayName>EnableSIMDMask</ipxact:displayName>
      <ipxact:value>true</ipxact:value>
      <ipxact:description>Enable status flags masking of inactive lanes</ipxact:description>
    </ipxact:parameter>
  </ipxact:parameters>
</ipxact:component>
