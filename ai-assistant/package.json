{
  "name": "@spec2gds/harness-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "profile",
    "bundles"
  ],
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:harness": "node --test tests/*integration.test.mjs",
    "eval": "npm run build:server && node scripts/evaluate.mjs",
    "request": "node scripts/request.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ui": "node --test tests/*.ui.test.mjs",
    "generate:tools": "node scripts/generate-tool-arguments.mjs",
    "check:tools": "node scripts/generate-tool-arguments.mjs --check",
    "prebuild:server": "npm run check:tools && node scripts/clean-server.mjs",
    "pretypecheck": "npm run check:tools",
    "pretest": "npm run check:tools"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-base": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-headless": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-prompt-catalog": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-prompt-catalog-yaml": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-s-workflow": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-s-workflow-yaml": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-web-app": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-event-system": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-event-system-yaml": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-goal": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-event-system-http": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow-runtime": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow-yaml": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow-model-native": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tool-flow": "0.1.6-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.5",
    "typescript": "5.8.3"
  }
}
