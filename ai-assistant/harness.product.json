{
  "schemaVersion": 1,
  "defaultProfile": "spec2gds-web",
  "profiles": {
    "spec2gds-web": {
      "bundles": [
        "@spec2gds/harness-assistant",
        "@spec2gds/harness-web"
      ],
      "localBundles": [
        ".",
        "bundles/web"
      ],
      "patchReload": "startup"
    },
    "spec2gds-headless": {
      "bundles": [
        "@spec2gds/harness-assistant",
        "@spec2gds/harness-headless"
      ],
      "localBundles": [
        ".",
        "bundles/headless"
      ],
      "patchReload": "startup"
    }
  },
  "releaseFiles": [
    "deployment",
    "harness.product.json",
    "README.md",
    "docs",
    "harness.lock.json"
  ]
}
