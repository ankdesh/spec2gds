[Unit]
Description=spec2hw AI Assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/apps/spec2gds-assistant/current
Environment=ASSISTANT_STATE=%h/.local/state/spec2gds-assistant
EnvironmentFile=%h/.config/spec2gds-assistant/environment
ExecStart=/usr/bin/env node %h/apps/spec2gds-assistant/current/deployment/launch.mjs --service-config %h/.config/spec2gds-assistant/services.json
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
