    "AgentProposal": {
      "additionalProperties": false,
      "description": "Persistable, whole-batch agent change proposal.",
      "properties": {
        "batch": {
          "$ref": "#/$defs/CommandBatch"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValidationDiagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "proposal_id": {
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "rejected",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "title",
        "batch"
      ],
      "title": "AgentProposal",
      "type": "object"
    },
    "ChangePreview": {
      "additionalProperties": false,
      "description": "Non-persisted result of validating one command batch.",
      "properties": {
        "batch": {
          "$ref": "#/$defs/CommandBatch"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/CircuitGraphSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/ValidationDiagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "batch",
        "diagnostics"
      ],
      "title": "ChangePreview",
      "type": "object"
    },
    "CircuitCapabilities": {
      "additionalProperties": false,
      "description": "Operations supported by the active backend adapter.",
