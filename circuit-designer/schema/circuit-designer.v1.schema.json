    "CommandBatch": {
      "additionalProperties": false,
      "description": "Ordered, revision-guarded set of proposed commands.",
      "properties": {
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "commands": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_instance": "#/$defs/AddInstanceCommand",
                "add_net_endpoint": "#/$defs/AddNetEndpointCommand",
                "create_net": "#/$defs/CreateNetCommand",
                "delete_instance": "#/$defs/DeleteInstanceCommand",
                "delete_net": "#/$defs/DeleteNetCommand",
                "duplicate_instances": "#/$defs/DuplicateInstancesCommand",
                "remove_net_endpoint": "#/$defs/RemoveNetEndpointCommand",
                "rename_net": "#/$defs/RenameNetCommand",
                "set_layout_direction": "#/$defs/SetLayoutDirectionCommand",
                "set_net_route": "#/$defs/SetNetRouteCommand",
                "set_node_geometry": "#/$defs/SetNodeGeometryCommand",
                "set_terminal_placement": "#/$defs/SetTerminalPlacementCommand",
                "update_instance": "#/$defs/UpdateInstanceCommand"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AddInstanceCommand"
              },
              {
                "$ref": "#/$defs/UpdateInstanceCommand"
              },
              {
                "$ref": "#/$defs/DuplicateInstancesCommand"
              },
              {
                "$ref": "#/$defs/DeleteInstanceCommand"
              },
              {
                "$ref": "#/$defs/CreateNetCommand"
              },
              {
                "$ref": "#/$defs/RenameNetCommand"
              },
              {
                "$ref": "#/$defs/AddNetEndpointCommand"
              },
              {
                "$ref": "#/$defs/RemoveNetEndpointCommand"
              },
              {
                "$ref": "#/$defs/DeleteNetCommand"
              },
              {
                "$ref": "#/$defs/SetNodeGeometryCommand"
              },
              {
                "$ref": "#/$defs/SetTerminalPlacementCommand"
              },
              {
                "$ref": "#/$defs/SetNetRouteCommand"
              },
              {
                "$ref": "#/$defs/SetLayoutDirectionCommand"
              }
            ]
          },
          "minItems": 1,
          "title": "Commands",
          "type": "array"
        },
        "expected_source_revision_hash": {
          "minLength": 1,
          "title": "Expected Source Revision Hash",
          "type": "string"
        }
      },
      "required": [
        "batch_id",
        "expected_source_revision_hash",
        "commands"
      ],
      "title": "CommandBatch",
      "type": "object"
    },
