    "CircuitGraphSnapshot": {
      "additionalProperties": false,
      "description": "Complete immutable graph payload for one design revision.",
      "properties": {
        "breadcrumbs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CircuitDesignRef"
          },
          "title": "Breadcrumbs",
          "type": "array"
        },
        "capabilities": {
          "$ref": "#/$defs/CircuitCapabilities",
          "default": {
            "edit_instance_details": false,
            "edit_layout": false,
            "edit_topology": false,
            "replace_component": false,
            "submit_agent_proposal": false
          }
        },
        "components": {
          "items": {
            "$ref": "#/$defs/CircuitComponentDefinition"
          },
          "title": "Components",
          "type": "array"
        },
        "design": {
          "$ref": "#/$defs/CircuitDesignRef"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagramLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nets": {
          "items": {
            "$ref": "#/$defs/CircuitNet"
          },
          "title": "Nets",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/CircuitNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "protocol_version": {
          "const": "circuit-designer.v1",
          "default": "circuit-designer.v1",
          "title": "Protocol Version",
          "type": "string"
        },
        "source_revision_hash": {
          "minLength": 1,
          "title": "Source Revision Hash",
          "type": "string"
        },
        "terminals": {
          "items": {
            "$ref": "#/$defs/CircuitTerminal"
          },
          "title": "Terminals",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "source_revision_hash",
        "design",
        "components",
        "nodes",
        "terminals",
        "nets"
      ],
      "title": "CircuitGraphSnapshot",
      "type": "object"
    },
    "CircuitNet": {
      "additionalProperties": false,
      "description": "One interface or ad-hoc multi-endpoint connection.",
